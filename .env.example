BDT_ENV=development
BDT_DATABASE_URL=sqlite:///data/bdt.db
BDT_DATA_DIR=data
BDT_DOCUMENT_STORE=data/document-originals
BDT_PORT=8008
# Local PostgreSQL stack (compose.postgres.yaml); not production.
BDT_POSTGRES_PORT=8009
BDT_POSTGRES_ORIGIN=http://127.0.0.1:8009,http://localhost:8009
BDT_PUBLIC_ORIGIN=http://127.0.0.1:8008,http://localhost:8008
BDT_ALLOWED_HOSTS=localhost,127.0.0.1
BDT_ALLOW_REGISTRATION=0
BDT_REVISION=development
BDT_STATIC_DIR=web/dist
