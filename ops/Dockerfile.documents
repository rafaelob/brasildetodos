FROM python:3.13-slim-bookworm
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils tesseract-ocr tesseract-ocr-por tesseract-ocr-eng tesseract-ocr-spa && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md LICENSE ./
COPY backend/ backend/
RUN pip install --no-cache-dir . && useradd --uid 10001 --create-home worker && mkdir /app/data && chown worker:worker /app/data
USER worker
ENV BDT_DATA_DIR=/tmp/data
ENTRYPOINT ["bdt","extract-pdf"]
